},
{
  "type": "range",
  "id": "bottom_cta_margin_top",
  "label": "Margem superior (desktop)",
  "min": -100,
  "max": 100,
  "step": 2,
  "unit": "px",
  "default": 24
},
{
  "type": "range",
  "id": "bottom_cta_margin_bottom",
  "label": "Margem inferior (desktop)",
  "min": -100,
  "max": 100,
  "step": 2,
  "unit": "px",
  "default": 0
},
{
  "type": "range",
