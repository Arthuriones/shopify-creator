

{% liquid
  assign max_items = section.settings.max_products

  if section.settings.collection != blank and shop.products_count != 0
    assign section_products = section.settings.collection.products
    assign max_items = section_products.size | at_most: section.settings.max_products
  endif

  case section.settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
      capture styles
        echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
        echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
        echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
        echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
      endcapture
    when 'carousel'
      assign classes = 'resource-list__carousel'
      capture styles
        echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
        echo '--column-count: ' | append: section.settings.columns | append: ';'
        echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
        echo '--mobile-card-size: ' | append: section.settings.mobile_card_size | append: ';'
      endcapture
  endcase
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="section-{{ section.id }}"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
    {% if request.design_mode == false and section.settings.collection == blank %}
      in-onboarding-state
    {% endif %}
  "
  style="
    --column-count-mobile: {{ section.settings.mobile_columns }};
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    {{ styles }}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% for i in (1..max_items) %}
      {% if section_products.size > 0 %}
        {% assign index = forloop.index0 %}
        {% assign product = section_products[index] %}
      {% else %}
        {% assign product = null %}
      {% endif %}
      <div
        class="resource-list__item"
      >
        {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
      </div>

      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}

    {% endfor %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  <div
    class="
      resource-list
      {% if section.settings.layout_type == 'carousel' %}
        force-full-width
      {% endif %}
      {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
        hidden--mobile
      {% endif %}
      {{ classes }}
    "
    style="{{ styles }}"
    {% if section.settings.layout_type == 'grid' %}
      data-testid="resource-list-grid"
    {% endif %}
  >
    {% case section.settings.layout_type %}
      {% when 'grid' %}
        {{ list_items }}
      {% when 'carousel' %}
        {% render 'resource-list-carousel',
          ref: 'resourceListCarousel',
          slides: list_items_array,
          slide_count: max_items,
          settings: section.settings
        %}
      {% when 'editorial' %}
        {% render 'editorial-product-grid', items: list_items_array %}
    {% endcase %}
  </div>

  {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
    {% liquid
      assign mobile_carousel_gap = section.settings.columns_gap
    %}
    <div
      class="
        resource-list
        hidden--desktop
        force-full-width
      "
      style="
        --resource-list-column-gap-desktop: {{ mobile_carousel_gap }}px;
        --column-count: {{ section.settings.columns }};
        --mobile-card-size: {{ section.settings.mobile_card_size }};
      "
    >
      {% render 'resource-list-carousel',
        ref: 'resourceListCarouselMobile',
        slides: list_items_array,
        slide_count: max_items,
        settings: section.settings
      %}
    </div>
  {% endif %}

{%- if section.settings.show_bottom_cta and section.settings.collection != blank -%}
  <div
    class="section-resource-list__footer"
    style="
      --cta-bg: {{ section.settings.bottom_cta_bg_color | default: 'var(--color-foreground)' }};
      --cta-fg: {{ section.settings.bottom_cta_text_color | default: 'var(--color-background)' }};
      --cta-radius: {{ section.settings.bottom_cta_radius | default: 8 }}px;
      --cta-pad-v: {{ section.settings.bottom_cta_pad_v | default: 12 }}px;
      --cta-pad-h: {{ section.settings.bottom_cta_pad_h | default: 18 }}px;
      --cta-justify: {{ section.settings.bottom_cta_align | default: 'center' }};
      /* NOVO: espaçamentos desktop */
      --cta-mt-desktop: {{ section.settings.bottom_cta_margin_top | default: 24 }}px;
      --cta-mb-desktop: {{ section.settings.bottom_cta_margin_bottom | default: 0 }}px;
      /* NOVO: espaçamentos mobile */
      --cta-mt-mobile: {{ section.settings.bottom_cta_margin_top_mobile | default: 16 }}px;
      --cta-mb-mobile: {{ section.settings.bottom_cta_margin_bottom_mobile | default: 0 }}px;
      /* NOVO: fontes */
      --cta-fs-desktop: {{ section.settings.bottom_cta_font_size | default: 16 }}px;
      --cta-fs-mobile: {{ section.settings.bottom_cta_font_size_mobile | default: 14 }}px;
    "
  >
    <div class="product-list__cta-wrapper">
      <a
        class="product-list__cta"
        href="{{ section.settings.collection.url }}"
        {% if section.settings.bottom_cta_open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.bottom_cta_label | default: 'Ver tudo' }}
      </a>
    </div>
  </div>
{%- endif -%}

{% style %}
  #section-{{ section.id }} .section-resource-list__footer {
    display: flex;
    justify-content: var(--cta-justify, center);
    /* Desktop (padrão) */
    margin-top: var(--cta-mt-desktop, 24px);
    margin-bottom: var(--cta-mb-desktop, 0px);
  }

  @media (max-width: 749px) {
    #section-{{ section.id }} .section-resource-list__footer {
      margin-top: var(--cta-mt-mobile, 16px);
      margin-bottom: var(--cta-mb-mobile, 0px);
    }
  }

  #section-{{ section.id }} .product-list__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--cta-pad-v, 12px) var(--cta-pad-h, 18px);
    background: var(--cta-bg, var(--color-foreground));
    color: var(--cta-fg, var(--color-background));
    border-radius: var(--cta-radius, 8px);
    text-decoration: none;
    font-weight: 600;
    line-height: 1;
    border: 1px solid transparent;
    transition: opacity .15s ease, transform .06s ease;
    will-change: opacity, transform;
    /* Fonte desktop (padrão) */
    font-size: var(--cta-fs-desktop, 16px);
  }

  @media (max-width: 749px) {
    #section-{{ section.id }} .product-list__cta {
      font-size: var(--cta-fs-mobile, 14px);
    }
  }

  #section-{{ section.id }} .product-list__cta:hover { opacity: .9; }
  #section-{{ section.id }} .product-list__cta:active { transform: translateY(1px); }

  /* (Opcional) Esconder o botão do cabeçalho quando estiver usando o CTA inferior */
  {% if section.settings.hide_header_button %}
    #section-{{ section.id }} .section-resource-list__header a,
    #section-{{ section.id }} .section-resource-list__header button { display: none !important; }
  {% endif %}
{% endstyle %}


  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
  
</div>

<script>
(function(){
  function initTapFix(root){
    if (!root || root.__tapFixV5) return;
    root.__tapFixV5 = true;

    var downX=0, downY=0, moved=false, card=null, anchor=null, quickBtn=null, skip=false;

    // BOTÃO real de Quick Add (apenas elementos clicáveis)
    var QA_BUTTON_SEL = [
      'button[name="add"]',
      'button[data-add-to-cart]',
      'button.quick-add',
      'button.quick-add__button',
      '[type="submit"][name="add"]',
      'a[role="button"][data-add-to-cart]'
    ].join(',');

    // Áreas interativas que não queremos interceptar
    var IGNORE_SEL = [
      'input','select','textarea','label','[contenteditable]',
      '.shopify-payment-button, .shopify-payment-button *',
      '[data-action]'
    ].join(',');

    // Link do produto dentro do card
    var PRODUCT_LINK_SEL =
      'a[href*="/products/"]:not([href^="#"]):not([role="button"])';

    function isTouchLike(e){
      return (e.pointerType && e.pointerType !== 'mouse') || e.type.indexOf('touch') === 0;
    }
    function pt(e){
      var t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]) || e;
      return {x:t.clientX, y:t.clientY};
    }

    // Encontra o botão de Quick Add exatamente sob o ponto (respeita overlays)
    function quickAddAtPoint(x,y){
      var stack = document.elementsFromPoint(x,y) || [];
      for (var i=0;i<stack.length;i++){
        var el = stack[i];
        var btn = el.closest && el.closest(QA_BUTTON_SEL);
        if (btn) return btn;
      }
      return null;
    }

    function onDown(e){
      if (!isTouchLike(e)) return;
      var p = pt(e);
      downX = p.x; downY = p.y; moved = false; skip = false; quickBtn = null;

      card = e.target.closest('.resource-list__item');
      if (!card){ anchor=null; return; }

      // 1) Se o toque caiu sobre o botão de Quick Add → prioriza botão
      quickBtn = quickAddAtPoint(p.x, p.y);
      if (quickBtn){
        anchor = null;
        return;
      }

      // 2) Se tocou em algo interativo que não é o botão, não intercepta
      if (e.target.closest(IGNORE_SEL)) { skip = true; anchor = null; return; }

      // 3) Se tocou num <a> que não é link de produto, não intercepta
      var a = e.target.closest('a[href]');
      if (a && !a.matches(PRODUCT_LINK_SEL)) { skip = true; anchor = null; return; }

      // 4) Seleciona link de produto do card
      anchor = (a && a.matches(PRODUCT_LINK_SEL)) ? a : card.querySelector(PRODUCT_LINK_SEL);
    }

    function onMove(e){
      if (!isTouchLike(e)) return;
      var p = pt(e);
      if (Math.abs(p.x - downX) > 8 || Math.abs(p.y - downY) > 8) moved = true; // libera swipe
    }

    function stopAll(e){
      if (e.cancelable) e.preventDefault();
      e.stopPropagation();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    }

    function onUp(e){
      if (!isTouchLike(e)) return;

      // Tap curto no botão de Quick Add → clicar imediatamente
      if (quickBtn && !moved){
        stopAll(e);
        try { quickBtn.click(); } catch (_) {}
        quickBtn=null; card=null; anchor=null;
        return;
      }

      // Tap curto no card → navegar ao produto
      if (card && anchor && !moved && !skip){
        stopAll(e);
        window.location.assign(anchor.href);
      }

      card=null; anchor=null; quickBtn=null;
    }

    // listeners em captura (antes do slider)
    root.addEventListener('pointerdown', onDown, {capture:true, passive:true});
    root.addEventListener('pointermove', onMove,  {capture:true, passive:true});
    root.addEventListener('pointerup',   onUp,    {capture:true, passive:false});
    // fallback iOS
    root.addEventListener('touchstart', onDown, {capture:true, passive:true});
    root.addEventListener('touchmove',  onMove,  {capture:true, passive:true});
    root.addEventListener('touchend',   onUp,    {capture:true, passive:false});
  }

  var root = document.getElementById('section-{{ section.id }}');
  initTapFix(root);

  document.addEventListener('shopify:section:load', function(ev){
    if (ev.target && ev.target.id === 'section-{{ section.id }}') initTapFix(ev.target);
  });
})();
</script>



{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
