  "id": "bottom_cta_align",
  "label": "Alinhamento do botão",
  "options": [
    { "value": "flex-start", "label": "Esquerda" },
    { "value": "center", "label": "Centro" },
    { "value": "flex-end", "label": "Direita" }
  ],
  "default": "center"
},
{
  "type": "color",
  "id": "bottom_cta_bg_color",
  "label": "Cor de fundo do botão",
  "default": "#fff"
},
{
  "type": "color",
  "id": "bottom_cta_text_color",
