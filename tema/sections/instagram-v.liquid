 :root {
     --hashtag-color: {{section.settings.hashtag_color}};
    --insta-btn-color: {{section.settings.insta-btn_color}};
    --insta-fonte-color: {{section.settings.insta-fonte_color}};

  --titulo-celular: {{section.settings.titulo_celular}}px;
     --titulo-desk: {{section.settings.titulo_desk}}px;

     --insta-icon-mobile: {{section.settings.tamanho_icon_mobile}}px;
 --insta-icon-desktop: {{section.settings.tamanho_icon_desktop}}px;
}
  /* ---------- DIMENSÕES BÁSICAS (sem mudanças) ---------- */
  #images-carousel-{{ section.id }}          { width:100%; }
  #images-carousel-{{ section.id }} .images-carousel-container { margin:0 auto; }
  #images-carousel-{{ section.id }} .section-heading{
    text-align:{{ section.settings.heading_alignment }};
    margin:0 0 35px;
    font-size:{% if section.settings.heading_size == 'small' %}24px{% elsif section.settings.heading_size == 'medium' %}32px{% else %}40px{% endif %};
  }
  #images-carousel-{{ section.id }} .images-carousel-wrapper{ position:relative; overflow:hidden; }
  #images-carousel-{{ section.id }} .images-carousel-slider{ overflow:hidden; position:relative; width:100%; }
  #images-carousel-{{ section.id }} .slider-track{ display:flex; gap:15px; transition:transform .5s ease-in-out; will-change:transform; }

  /* Largura de cada slide (desktop) */
  #images-carousel-{{ section.id }} .slide{
    flex:0 0 calc((100% - ({{ section.settings.visible_images | minus:1 }} * 15px)) / {{ section.settings.visible_images }});
  }
  /* Largura de cada slide (mobile) */
  @media(max-width:767px){
    #images-carousel-{{ section.id }} .slide{
      flex:0 0 calc((100% - ({{ section.settings.visible_mobile | minus:1 }} * 15px)) / {{ section.settings.visible_mobile }});
    }
  }
  #images-carousel-{{ section.id }} .slide img.carousel-image{
    width:100%; object-fit:cover;
    {% case section.settings.image_design %}
      {% when "square" %}   aspect-ratio:1/1;
      {% when "circle" %}   aspect-ratio:1/1; border-radius:50%;
      {% when "portrait" %} aspect-ratio:2/3;
    {% endcase %}
    {% if section.settings.image_shadow %}box-shadow:0 4px 8px rgba(0,0,0,.2);{% endif %}
  }

  /* ---------- ARROWS ---------- */
  #images-carousel-{{ section.id }} .arrow{
    background:{{ section.settings.arrow_bg_color }};
    color:#fff; border:none; width:40px; height:40px; font-size:20px; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    position:absolute; top:50%; transform:translateY(-50%);
    border-radius:{% if section.settings.arrow_shape == "circle" %}50%{% else %}0{% endif %};
    transition:opacity .3s;
  }
  #images-carousel-{{ section.id }} .left-arrow { left:5px; }
  #images-carousel-{{ section.id }} .right-arrow{ right:5px; }

  /* → visibilidade das setas */
  /* desktop (≥768 px): escondidas até o hover */
  @media(min-width:768px){
    #images-carousel-{{ section.id }} .arrow{ opacity:0; pointer-events:none; }
    #images-carousel-{{ section.id }} .images-carousel-wrapper:hover .arrow{
      opacity:1; pointer-events:auto;
    }
  }
  /* mobile (≤767 px): setas nunca aparecem */
  @media(max-width:767px){
    #images-carousel-{{ section.id }} .arrow{ display:none; }
  }

  /* ---------- DOTS (só mobile) ---------- */
  @media(max-width:767px){
    #images-carousel-{{ section.id }} .carousel-dots{
      display:flex; justify-content:center; gap:6px; margin-top:10px;
    }
    #images-carousel-{{ section.id }} .carousel-dots .dot{
      width:6px; height:6px; border-radius:50%; background:#d0d0d0; transition:background .3s;
    }
    #images-carousel-{{ section.id }} .carousel-dots .dot.active{ background:#606060; }
  }

  /* mantém o slider abaixo de tudo */
#images-carousel-{{ section.id }} .images-carousel-slider{
  position: relative;     /* já existe – apenas garanta que ficou */
  z-index: 1;             /* NOVO */
}

/* garante que as setas fiquem sempre por cima */
#images-carousel-{{ section.id }} .arrow{
  z-index: 100;           /* NOVO – qualquer valor alto funciona */
}

