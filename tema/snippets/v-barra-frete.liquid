{% assign progress_bar_color = settings.shipping_bar_color %}
{% assign shipping_text_color = settings.shipping_text_color | default: "#000000" %}
{% assign shipping_text_size = settings.shipping_text_size | default: 16 %}
{% assign shipping_text_align = settings.shipping_text_align | default: "left" %}
<div class="onhow-upsell-container">
  {% assign shipping_value = settings.minimum_free_shipping | times: 100 %}
  {% assign cart_total = cart.total_price %}
  {% assign shipping_value_left = shipping_value | minus: cart_total %}
  {% assign shipping_percentage_fraction = cart_total | times: 100 | divided_by: shipping_value | minus:7 %}
  <div class="onhow-shipping-message" style="color: {{ shipping_text_color }}; font-size: {{ shipping_text_size }}px; text-align: {{ shipping_text_align }};">
    {% if shipping_value_left > 0 %}
      <span class="onhow-before-amount">{{ settings.text_before_amount }}</span>
      <span class="onhow-free-shipping-notice"><strong>{{ shipping_value_left | money }}</strong></span>
      <span class="onhow-after-amount">{{ settings.text_after_amount }}</span>
    {% elsif shipping_value_left <= 0 %}
      <span class="onhow-free-shipping-message">{{ settings.free_shipping_text }}</span>
    {% endif %}
  </div>
  <div class="onhow-progress-bar">
    <div class="onhow-progress-bar-done" data-progress="loading"><span></span></div>
    
    <div class="onhow-free-shipping-icon {% if shipping_value_left <= 0 %} onhow-iconicion {% endif %}"> 
      
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="    width: 25px;
    height: 25px;"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path fill="{{settings.shipping_icon_color}}" d="M64 160C64 124.7 92.7 96 128 96L416 96C451.3 96 480 124.7 480 160L480 192L530.7 192C547.7 192 564 198.7 576 210.7L621.3 256C633.3 268 640 284.3 640 301.3L640 448C640 483.3 611.3 512 576 512L572.7 512C562.3 548.9 528.3 576 488 576C447.7 576 413.8 548.9 403.3 512L300.7 512C290.3 548.9 256.3 576 216 576C175.7 576 141.8 548.9 131.3 512L128 512C92.7 512 64 483.3 64 448L64 400L24 400C10.7 400 0 389.3 0 376C0 362.7 10.7 352 24 352L136 352C149.3 352 160 341.3 160 328C160 314.7 149.3 304 136 304L24 304C10.7 304 0 293.3 0 280C0 266.7 10.7 256 24 256L200 256C213.3 256 224 245.3 224 232C224 218.7 213.3 208 200 208L24 208C10.7 208 0 197.3 0 184C0 170.7 10.7 160 24 160L64 160zM576 352L576 301.3L530.7 256L480 256L480 352L576 352zM256 488C256 465.9 238.1 448 216 448C193.9 448 176 465.9 176 488C176 510.1 193.9 528 216 528C238.1 528 256 510.1 256 488zM488 528C510.1 528 528 510.1 528 488C528 465.9 510.1 448 488 448C465.9 448 448 465.9 448 488C448 510.1 465.9 528 488 528z"/></svg>

    </div>




  </div>
</div>
{% comment %}
<!-- Designed by OnHOW YouTube Channel - Anas El Medlaoui -->
{% endcomment %}
<style>
  .onhow-upsell-container {
    width: 100%;
    display: flex
;
    flex-direction: column;
    margin-bottom: -20px;
    margin-top: 0px;
    border-top: 1px solid #ccc;
    padding-top: 10px;
  }
  .onhow-shipping-message {
    width: 100%;
    margin-bottom: 0.5rem;
  }
  .onhow-shipping-message p {
    margin: 0;
    padding: 0;
    display: inline;
  }
  .onhow-shipping-message strong {
    font-weight: bold;
  }
  .onhow-progress-bar {
    background-color: #E2E4E3;
    display: flex;
    height: 1em;
    width: 100%;
    border-radius: 0.75em;
    padding: 3px;
    position: relative;
    align-items: center;
  }
  
  .onhow-progress-bar-done {
    display: flex;
    text-align: center;
    align-items: center;
    justify-content: center;
    background-color: {{ progress_bar_color }};
    background-image: repeating-linear-gradient(
      to left,
      {{ progress_bar_color }},
      {{ progress_bar_color | color_lighten: 15 }},
      {{ progress_bar_color | color_lighten: 30 }}
    );
    box-shadow: 0 5px 5px -6px {{ progress_bar_color }};
    border-radius: 0.75em;
    height: 100%;
    transition: 1s ease 0.3s;
    max-width: 93%;
    width: {{ shipping_percentage_fraction }}%;
  }
  
  .onhow-free-shipping-icon {
    position: absolute;
    right: 0;
    width: 35px;
    height: 35px;
    border-radius: 100px;
    background-color:rgb(243, 243, 243);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .onhow-progress-bar::before {
    content: ' ';
  }
  .onhow-iconicion {
    box-shadow: 0 0 10px rgba(62, 101, 207, 0.5);
    border: 1px solid black;
    transition: 1s ease 0.7s;
  }
</style>