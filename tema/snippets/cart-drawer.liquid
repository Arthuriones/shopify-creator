  .cart-drawer__inner { height: 100%; overflow: hidden; }
  .cart-drawer__content { height: 100%; display: flex; flex-direction: column; } /* (antes: calc(100% - var(--header-height))) */

  /* ===== Layout 2 colunas ===== */
  .cart-drawer__layout { display: flex; height: 100%; gap: 1.6rem; }

  /* Coluna de Recomendados — ocupa altura inteira e rola independente */
  .cart-drawer__recommendations-column {
    flex: 0 0 20rem; max-width: 20rem; height: 100%;
    padding: var(--cart-drawer-padding);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
