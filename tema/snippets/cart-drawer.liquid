  .cart-drawer__recommendations-empty { font-size: var(--font-size-small, 0.85rem); opacity: 0.7; }

  /* Nav (setas + dots) apenas no mobile */
  .hidden-desktop { display: none; }
  @media (max-width: 749px) {
    .hidden-desktop { display: flex; justify-content: center; align-items: center; gap: .75rem; margin-top: .25rem; }
    .reco-slider-nav { position: relative; }
    .reco-arrow {
      width: 25px; height: 25px; border-radius: 999px; background: #000; color: #fff; border: none;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .reco-arrow svg { width: 18px; height: 18px; }
    .reco-dots { display: inline-flex; gap: 6px; }
    .reco-dot { width: 8px; height: 8px; border-radius: 999px; background: rgba(0,0,0,.25); border: none; }
    .reco-dot.is-active { background: rgba(0,0,0,.7); }
  }

  /* (opcional) largura do drawer no desktop */
  @media (min-width: 990px) {
    .cart-drawer__dialog.dialog-drawer {
      max-width: none !important;
      inline-size: min(780px, calc(60vw - 48px)) !important;
    }
  }

  h3.cart-drawer__recommendations-title {
    text-align: center;
}

.cart-drawer__recommendation-cta {
  transform: scale(1);
  transform-origin: center;
  transition: transform 200ms cubic-bezier(.2,.8,.2,1),
              opacity 200ms ease;
  will-change: transform, opacity; /* opcional */
  backface-visibility: hidden; 
  font-weight: 600;    /* ajuda a evitar tremidos */
}

.cart-drawer__recommendation-cta:hover {
  opacity: .95;
  transform: scale(1.06); /* 1.10 é mais brusco */
}

.cart-drawer__recommendation-cta:active {
  transform: scale(.99); /* feedback no clique */
}

/* Acessibilidade */
@media (prefers-reduced-motion: reduce) {
  .cart-drawer__recommendation-cta { transition: none; }
}


