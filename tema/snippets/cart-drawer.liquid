{%- if single_variant and first_available -%}
  <button
    type="button"
    class="cart-drawer__recommendation-cta"
    data-direct-variant-id="{{ first_available.id }}"
    data-product-handle="{{ p.handle }}"
    aria-label="Adicionar {{ p.title }}"
  >{{settings.textocarrinhobotao }}</button>
{%- elsif single_variant and first_available == nil -%}
  <button
    type="button"
    class="cart-drawer__recommendation-cta"
    disabled
    aria-disabled="true"
  >{{settings.textocarrinhobotao3 }}</button>
{%- else -%}
  <button
    type="button"
    class="cart-drawer__recommendation-cta"
    data-open-qa
    data-product-handle="{{ p.handle }}"
    aria-label="Escolher opções de {{ p.title }}"
  >{{settings.textocarrinhobotao2 }}</button>
{%- endif -%}
      </div>

      {%- assign used_handles = used_handles | append: '|' | append: p.handle | append: '|' -%}
      {%- assign shown = shown | plus: 1 -%}
