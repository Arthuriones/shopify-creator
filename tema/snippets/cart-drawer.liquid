{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.
  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-label="{{ 'accessibility.open_cart_drawer' | t }} {{ 'accessibility.cart_count' | t}}: {{ cart.item_count }}"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    scroll-lock
  >

    <div class="reco-quickadd" data-reco-qa hidden aria-hidden="true" role="dialog" aria-modal="true">
  <div class="reco-quickadd__backdrop" data-reco-qa-close></div>
  <div class="reco-quickadd__panel" role="document">
    <button type="button" class="reco-quickadd__close" data-reco-qa-close aria-label="Fechar">×</button>
    <div class="reco-quickadd__head">
      <div class="reco-quickadd__thumb" data-qa-thumb></div>
      <div class="reco-quickadd__title" data-qa-title></div>
    </div>
    <form class="reco-quickadd__form" data-qa-form>
      <div class="reco-quickadd__options" data-qa-options></div>
      <div class="reco-quickadd__qty">
        <label>Qtd.</label>
        <input type="number" min="1" step="1" value="1" data-qa-qty>
      </div>
      <div class="reco-quickadd__status" data-qa-status></div>
      <button type="submit" class="reco-quickadd__submit" data-qa-submit disabled>{{settings.textocarrinhobotao4}}</button>
    </form>
  </div>
</div>
    
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div class="cart-drawer__content motion-reduce" aria-label="{{ 'accessibility.cart' | t }}">
            <span class="cart-drawer__heading h3 cart-drawer__heading--empty">
              {{ 'content.your_cart_is_empty' | t }}
            </span>


            
            <div class="cart-drawer__items">
              {% render 'cart-products' %}
            </div>
          </div>
        {%- else -%}

          {%- comment -%} Primeira coleção do primeiro item para recomendações {%- endcomment -%}
          {%- assign related_collection = nil -%}
          {%- assign first_item = cart.items | first -%}
          {%- if first_item and first_item.product and first_item.product.collections.size > 0 -%}
            {%- assign related_collection = first_item.product.collections.first -%}
          {%- endif -%}
          {%- assign cart_handles = cart.items | map: 'product' | map: 'handle' -%}

          <div class="cart-drawer__content motion-reduce" aria-label="{{ 'accessibility.cart' | t }}">
            <div class="cart-drawer__layout">
              <!-- BLOCO ESQUERDO: RECOMENDADOS (vai até o topo) -->

{%- if settings.mostrarrecomendados -%}
              <aside class="cart-drawer__recommendations-column" aria-label="Recommended products">
                <h3 class="cart-drawer__recommendations-title">
                  {{settings.textocarrinholateral}}
                </h3>

                <div class="cart-drawer__recommendations-list" data-reco-list>
  {%- assign max_recos = 10 -%}
  {%- assign min_recos = 8 -%}
  {%- assign shown = 0 -%}

  {%- comment -%} Index de handles já usados (inclui os do carrinho) {%- endcomment -%}
  {%- assign used_handles = '' -%}
  {%- for h in cart_handles -%}
    {%- assign used_handles = used_handles | append: '|' | append: h | append: '|' -%}
  {%- endfor -%}

  {%- comment -%} 1) Coleção relacionada (se tiver > 1 produto) {%- endcomment -%}
  {%- assign related_count = 0 -%}
  {%- if related_collection -%}
    {%- assign related_count = related_collection.products_count | default: 0 | plus: 0 -%}
  {%- endif -%}
  {%- if related_collection and related_count > 1 -%}
    {%- for p in related_collection.products limit: 50 -%}
      {%- assign needle = '|' | append: p.handle | append: '|' -%}
      {%- if used_handles contains needle or cart_handles contains p.handle or p.available == false -%}{% continue %}{%- endif -%}

      <div class="cart-drawer__recommendation reco-slide" data-product-handle="{{ p.handle }}">
        <button type="button" class="cart-drawer__recommendation-main" data-product-url="{{ p.url }}" aria-label="Abrir {{ p.title }}">
          <div class="cart-drawer__recommendation-image-wrapper">
            {%- if p.featured_image -%}
              {{ p.featured_image
                | image_url: width: 320
                | image_tag:
                  class: 'cart-drawer__recommendation-image',
                  loading: 'lazy',
                  alt: p.featured_image.alt | escape
              }}
            {%- endif -%}
          </div>
          <div class="cart-drawer__recommendation-info">
            <span class="cart-drawer__recommendation-title">{{ p.title }}</span>
            <span class="cart-drawer__pricewrap" data-price-wrap>
  <span
    class="cart-drawer__recommendation-price money"
    data-cents="{{ p.price }}"
    data-shop-currency="{{ shop.currency }}"
  >
    {{ p.price | money }}
  </span>
  {%- if p.compare_at_price and p.compare_at_price > p.price -%}
    <span
      class="cart-drawer__recommendation-compare money"
      data-cents="{{ p.compare_at_price }}"
      data-shop-currency="{{ shop.currency }}"
    >
      {{ p.compare_at_price | money }}
    </span>
  {%- else -%}
    <span class="cart-drawer__recommendation-compare is-placeholder">0</span>
  {%- endif -%}
</span>
          </div>
        </button>
       {%- liquid
  assign single_variant = false
  if p.has_only_default_variant
    assign single_variant = true
  elsif p.variants.size == 1
    assign single_variant = true
  endif

  assign first_available = nil
  for v in p.variants
