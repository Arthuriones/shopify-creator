/* Quick Add (recomendações no drawer) */
.reco-quickadd[hidden]{ display:none !important; }
.reco-quickadd{
  position:fixed; inset:0; z-index:9999;
  display:grid; place-items:center;
}
.reco-quickadd__backdrop{
  position:absolute; inset:0; background:rgba(0,0,0,.45);
}
.reco-quickadd__panel{
  position:relative; width:min(560px, 92vw); max-height:85vh; overflow:auto;
  background:var(--color-background, #fff); color:var(--color-foreground, #111);
  border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,.25);
  padding:30px;
}
.reco-quickadd__close{
  position:absolute; top:8px; right:8px; border:none; background:transparent;
  font-size:35px; line-height:1; cursor:pointer;color:#000 !important;
}
.reco-quickadd__head{ display:flex; gap:12px; align-items:center; margin-bottom:12px; }
.reco-quickadd__thumb img{ width:120px; height:auto; object-fit:cover; border-radius:8px; display:block; }
.reco-quickadd__title{ font-weight:600; font-size:1rem; line-height:1.3; }
.reco-quickadd__options{ display:grid; gap:10px; margin:12px 0; }
.reco-quickadd__options label{ display:block; font-size:.85rem; margin-bottom:6px; opacity:.9; }
.reco-quickadd__options select{
  width:100%; border:1px solid rgba(0,0,0,.15); border-radius:8px; padding:.6rem .7rem; background:#fff;
}
.reco-quickadd__qty{ display:flex; align-items:center; gap:10px; margin:8px 0 14px; }
.reco-quickadd__qty input{
  width:90px; border:1px solid rgba(0,0,0,.15); border-radius:8px; padding:.45rem .6rem;
}
.reco-quickadd__status{ min-height:1.2em; font-size:.9rem; opacity:.9; margin-bottom:10px; }
.reco-quickadd__submit{
  width:100%; padding:.9rem 1rem; border-radius:10px; border:none;
  background:var(--fundoadd); color:var(--fonteadd);
  font-weight:600; cursor:pointer; transition:.2s;
}
.reco-quickadd__submit[disabled]{ opacity:.5; cursor:not-allowed; }
.reco-quickadd__submit:hover:not([disabled]){ filter:brightness(1.05); transform:translateY(-1px); }

/* Título do QA vira "coluna" para o preço ficar logo abaixo */
.reco-quickadd__head { align-items: flex-start; }
.reco-quickadd__title {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 1.05rem;           /* leve aumento no título */
}

/* Linha de preço sob o título */
.qa-price-line { font-size: 1.05rem; line-height: 1.2; font-weight: 700; }
.qa-price-line .qa-price__compare {
  font-weight: 500;
  text-decoration: line-through;
  opacity: .7;
  font-size: .9em;               /* um pouco menor que o preço atual */
  margin-left: .4rem;
}

/* Selects das opções: fonte maior */
.reco-quickadd__options select {
  font-size: 1rem;               /* ↑ */
  padding: .7rem .8rem;          /* um pouco mais alto/largo */
}

/* Botão Adicionar ao carrinho: fonte maior */
.reco-quickadd__submit {
  font-size: 1.05rem;            /* ↑ */
  padding: 1rem 1.15rem;         /* ↑ */
}


