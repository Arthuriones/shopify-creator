        "default": "#fff"
      },
      {
        "type": "color",
        "id": "whatscompra_cor4",
        "label": "Background hover",
        "default": "#000"
      },

    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "range",
      "id": "menu_spacing",
