
  {% render 'fabricante' %}


{% schema %}
{
  "name": "Fabricante produto",
  "tag": null,
  "settings": [
    
    {
      "type": "range",
      "id": "margin-topfabricante",
      "label": "Margem Superior",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
     {
      "type": "range",
      "id": "margin-bottomfabricante",
      "label": "Margem Inferior",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
     },
       {
      "type": "range",
      "id": "opacidadefabricante",
      "label": "Opacidade fabricante",
      "min": 0.2,
      "max": 1.0,
      "step": 0.1,
      "default": 0.7
     },
     {
      "type": "range",
      "id": "fontefabricante",
      "label": "Fonte Fabricante",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16
     },
      {
        "type": "checkbox",
        "id": "negritofabricante",
        "label": "Aplicar negrito",
        "default": true
      },
      {
        "type": "text",
        "id": "textofabricante",
        "label": "Texto Fabricante (opcional)",
        "default": "Fabricante:"
      }
    
  ],
  "presets": [
    {
      "name": "Fabricante produto",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
