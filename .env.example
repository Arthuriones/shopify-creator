# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: used by Vercel Cron as Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me
# Optional: fallback proxy for AliExpress fetch in production
# Example template with placeholder: https://your-proxy.example/scrape?url={url}
ALIEXPRESS_FETCH_PROXY_URL=
# Optional: Bright Data direct fallback (Web Unlocker API)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_COUNTRY=br
# Optional: Bright Data native proxy fallback
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
BRIGHTDATA_PROXY_INSECURE_TLS=true

# Shopify (credenciais ficam no Supabase por loja)

# Meta / Instagram
# Prefer these when using Instagram API with Instagram Login.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Backward-compatible fallback for older Meta/Facebook Login integrations.
META_APP_ID=
META_APP_SECRET=
# Optional: keep aligned with Meta docs when upgrading Graph API versions.
META_GRAPH_VERSION=v24.0
