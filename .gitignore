# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imagens geradas pelo agent de design
geradas/

# artefatos de execucao local (logs, screenshots de debug, dumps de scrape)
*.log
.dev-check.log
.artifacts-*.png
failed_html.html
aliexpress_data.json
._*

# artefatos do preview de componentes (render isolado para revisar design)
.preview-out/
.preview-render.mjs
.preview-in.css

# estado local da CLI do Supabase (link, versoes, url do pooler)
supabase/.temp/
